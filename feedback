// /api/ai-feedback.js
// Serverless-функция (формат Vercel / Netlify Functions).
// КЛЮЧ API ХРАНИТСЯ ТОЛЬКО ЗДЕСЬ, на сервере, через переменные окружения.
// Никогда не кладите ключ в клиентский JS — иначе его увидит любой в devtools.

export default async function handler(req, res) {
  if (req.method !== 'POST') {
    return res.status(405).json({ error: 'Method not allowed' });
  }

  const { examKey, correctCount, totalQuestions, questions } = req.body;

  if (!questions || !Array.isArray(questions)) {
    return res.status(400).json({ error: 'Некорректные данные теста' });
  }

  const isTopik2 = examKey && examKey.includes('topik2');
  const maxScale = isTopik2 ? 300 : 200;
  const percent = correctCount / totalQuestions;
  const finalScore = Math.round(percent * maxScale);

  // Считаем гып по официальной шкале NIIED — это не ИИ-решение,
  // это детерминированная логика, ИИ только комментирует результат.
  let grade = 'Не сдан';
  if (isTopik2) {
    if (finalScore >= 230) grade = '6 급';
    else if (finalScore >= 190) grade = '5 급';
    else if (finalScore >= 150) grade = '4 급';
    else if (finalScore >= 120) grade = '3 급';
  } else {
    if (finalScore >= 140) grade = '2 급';
    else if (finalScore >= 80) grade = '1 급';
  }

  // Собираем компактный список ошибок, чтобы не гонять в промпте лишнее
  const mistakes = questions
    .map((q, i) => ({ ...q, index: i + 1 }))
    .filter(q => {
      const isCorrect = q.isCorrect !== undefined ? q.isCorrect : q.userAnswer === q.correctAnswer;
      return !isCorrect;
    });

  const prompt = `Ты — эксперт-методист по корейскому языку и экзамену TOPIK.
Экзамен: ${isTopik2 ? 'TOPIK II' : 'TOPIK I'}. Результат: ${correctCount}/${totalQuestions} правильных, ${finalScore}/${maxScale} баллов, присвоен уровень ${grade}.

Список вопросов, где студент ошибся (JSON):
${JSON.stringify(mistakes.map(m => ({
  номер: m.index,
  вопрос: m.title || m.question,
  ответ_студента: m.userAnswer,
  правильный_ответ: m.correctAnswer
})), null, 2)}

Задача:
1. Дай общий разбор результата (2-4 предложения): на что похожи ошибки, какой уровень навыка это отражает, что подтянуть для следующего гыпа. Без выдуманных фактов о студенте, только по данным выше.
2. Для КАЖДОГО вопроса из списка ошибок дай короткое объяснение (1-2 предложения): почему выбранный ответ студента неверен и почему правильный ответ верен — грамматически или по смыслу.

Ответь СТРОГО в формате JSON без markdown-обёртки:
{
  "overallFeedback": "текст общего разбора",
  "questionFeedback": [
    { "index": номер_вопроса, "explanation": "текст объяснения" }
  ]
}`;

  try {
    const response = await fetch('https://api.anthropic.com/v1/messages', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'x-api-key': process.env.ANTHROPIC_API_KEY, // задаётся в настройках хостинга, НЕ в коде
        'anthropic-version': '2023-06-01'
      },
      body: JSON.stringify({
        model: 'claude-sonnet-4-6',
        max_tokens: 1500,
        messages: [{ role: 'user', content: prompt }]
      })
    });

    if (!response.ok) {
      const errText = await response.text();
      throw new Error(`AI API error: ${response.status} ${errText}`);
    }

    const data = await response.json();
    const rawText = data.content
      .filter(block => block.type === 'text')
      .map(block => block.text)
      .join('\n');

    const cleaned = rawText.replace(/```json|```/g, '').trim();
    const parsed = JSON.parse(cleaned);

    return res.status(200).json({
      finalScore,
      maxScale,
      grade,
      overallFeedback: parsed.overallFeedback,
      questionFeedback: parsed.questionFeedback
    });
  } catch (err) {
    console.error('AI feedback error:', err);
    return res.status(500).json({
      error: 'Не удалось получить AI-фидбек',
      finalScore,
      maxScale,
      grade
    });
  }
}
