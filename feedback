export default async function handler(req, res) {
  if (req.method !== 'POST') {
    return res.status(405).json({ error: 'Method not allowed' });
  }

  const { examKey, correctCount, totalQuestions, questions } = req.body;

  if (!questions || !Array.isArray(questions)) {
    return res.status(400).json({ error: 'Некорректные данные теста' });
  }

  const isTopik2 = examKey && examKey.includes('topik2');
  const maxScale = isTopik2 ? 300 : 200;
  const percent = totalQuestions > 0 ? correctCount / totalQuestions : 0;
  const finalScore = Math.round(percent * maxScale);

  let grade = 'Не сдан';
  if (isTopik2) {
    if (finalScore >= 230) grade = '6 급';
    else if (finalScore >= 190) grade = '5 급';
    else if (finalScore >= 150) grade = '4 급';
    else if (finalScore >= 120) grade = '3 급';
  } else {
    if (finalScore >= 140) grade = '2 급';
    else if (finalScore >= 80) grade = '1 급';
  }

  // Если ошибок нет — отдаем позитивный ответ без запроса к ИИ (экономия токенов)
  const mistakes = questions
    .map((q, i) => ({ ...q, index: i + 1 }))
    .filter(q => {
      const isCorrect = q.isCorrect !== undefined ? q.isCorrect : q.userAnswer === q.correctAnswer;
      return !isCorrect;
    });

  if (mistakes.length === 0) {
    return res.status(200).json({
      finalScore,
      maxScale,
      grade,
      overallFeedback: "Отличный результат! Вы не допустили ни одной ошибки. Продолжайте в том же духе!",
      questionFeedback: []
    });
  }

  const systemPrompt = `Ты — методист по корейскому языку и экзамену TOPIK.
Отвечай ИСКЛЮЧИТЕЛЬНО в формате валидного JSON без какого-либо текста до или после, и без markdown-тегов (```json).
Формат ответа:
{
  "overallFeedback": "строка с общим разбором",
  "questionFeedback": [
    { "index": число, "explanation": "строка с объяснением" }
  ]
}`;

  const userPrompt = `Экзамен: ${isTopik2 ? 'TOPIK II' : 'TOPIK I'}. 
Результат: ${correctCount}/${totalQuestions} правильных, ${finalScore}/${maxScale} баллов, уровень: ${grade}.

Ошибки студента:
${JSON.stringify(mistakes.map(m => ({
  номер: m.index,
  вопрос: m.title || m.question,
  варианты_ответа: m.options || undefined,
  ответ_студента: m.userAnswer,
  правильный_ответ: m.correctAnswer
})), null, 2)}

Инструкции:
1. overallFeedback (2-3 предложения): кратко проанализируй, какие грамматические темы или лексика вызвали проблемы и что повторить.
2. questionFeedback: для каждого вопроса объясни, почему ответ студента не верен и почему правильный вариант корректен.`;

  try {
    const response = await fetch('https://api.anthropic.com/v1/messages', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'x-api-key': process.env.ANTHROPIC_API_KEY,
        'anthropic-version': '2023-06-01'
      },
      body: JSON.stringify({
        model: 'claude-3-5-sonnet-20241022', // Актуальное имя модели
        max_tokens: 1500,
        system: systemPrompt, // Системные инструкции передаем в специальном поле
        messages: [{ role: 'user', content: userPrompt }]
      })
    });

    if (!response.ok) {
      const errText = await response.text();
      throw new Error(`AI API error: ${response.status} ${errText}`);
    }

    const data = await response.json();
    const rawText = data.content
      .filter(block => block.type === 'text')
      .map(block => block.text)
      .join('\n');

    // Очистка от возможных markdown-тегов
    const cleaned = rawText.replace(/```json\s*|```/gi, '').trim();
    const parsed = JSON.parse(cleaned);

    return res.status(200).json({
      finalScore,
      maxScale,
      grade,
      overallFeedback: parsed.overallFeedback,
      questionFeedback: parsed.questionFeedback
    });
  } catch (err) {
    console.error('AI feedback error:', err);
    return res.status(500).json({
      error: 'Не удалось получить AI-фидбек',
      finalScore,
      maxScale,
      grade
    });
  }
}
